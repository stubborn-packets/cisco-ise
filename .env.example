# Copy to .env and fill in. Never commit .env.
# Phase 1 export and Phase 3 Terraform both read these names.

ISE_URL=https://ise.lab.example
ISE_USERNAME=ise-api-username
ISE_PASSWORD=

# Lab evals usually present a private CA. true = skip TLS verify.
# Provider default is also true if unset.
ISE_INSECURE=true

# Optional. Seconds. Provider default 60.
# ISE_REQUEST_TIMEOUT=60