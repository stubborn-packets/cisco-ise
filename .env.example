# Copy to .env and fill in. Never commit .env.
#
# Copy to .env and fill in. Never commit .env.
#
# Terraform (CiscoDevNet/ise) reads the plain ISE_* names.
# Scripts after Phase 14 read the prefixed names when --environment is used.
# Keep both. The plain names can be set from the prefixed ones.

# *_ISE_URL = https://ise.lab.example
# *_ISE_USERNAME = ers-ise-username
# *_ISE_PASSWORD = ers-ise-password
# *_ISE_INSECURE = true (skip TLS verify)

# Default environment (scripts: --environment lab)
LAB_ISE_URL=
LAB_ISE_USERNAME=
LAB_ISE_PASSWORD=
LAB_ISE_INSECURE=true

# staging environment (scripts: --environment stage)
STAGE_ISE_URL=...
STAGE_ISE_USERNAME=...
STAGE_ISE_PASSWORD=...
STAGE_ISE_INSECURE=true

# production environment (scripts: --environment prod)
PROD_ISE_URL=...
PROD_ISE_USERNAME=...
PROD_ISE_PASSWORD=...
PROD_ISE_INSECURE=true

# Plain (Terraform provider). Same values.
ISE_URL=${LAB_ISE_URL}
ISE_USERNAME=${LAB_ISE_USERNAME}
ISE_PASSWORD=${LAB_ISE_PASSWORD}
ISE_INSECURE=${LAB_ISE_INSECURE}