# Copy this file to .env and fill in real values. .env itself is git-ignored —
# never commit real credentials. This is a temporary convenience for local
# Phase 1 testing; Phase 3+ moves ISE credentials into the existing HashiCorp
# Vault setup (see docs/adr/0002-tech-stack-selection.md) instead of .env.

# ciscoisesdk reads these automatically if present in the environment.
IDENTITY_SERVICES_ENGINE_USERNAME=
IDENTITY_SERVICES_ENGINE_PASSWORD=
IDENTITY_SERVICES_ENGINE_BASE_URL=https://your-home-lab-ise:9060
IDENTITY_SERVICES_ENGINE_VERSION=3.3_patch_1
IDENTITY_SERVICES_ENGINE_USES_API_GATEWAY=true

# Copy to .env and fill locally. Never commit .env.
# Phase 0: unused. Phase 1+ scripts and Phase 3+ Terraform read these.

ISE_URL=https://ise-lab.example.local
ISE_USERNAME=ers-admin
ISE_PASSWORD=change-me
ISE_INSECURE=true

# Optional CiscoDevNet/ise aliases
# ISE_REQUEST_TIMEOUT=60
# ISE_RETRIES=3