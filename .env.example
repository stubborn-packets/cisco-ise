# Copy to .env and fill in. Never commit .env.

# *_ISE_URL = https://ise.lab.example
# *_ISE_USERNAME = ers-ise-username
# *_ISE_PASSWORD = ers-ise-password
# *_ISE_INSECURE = true (skip TLS verify)

# Default environment
LAB_ISE_URL=
LAB_ISE_USERNAME=
LAB_ISE_PASSWORD=
LAB_ISE_INSECURE=true

# staging environment (if available)
STAGE_ISE_URL=...
STAGE_ISE_USERNAME=...
STAGE_ISE_PASSWORD=...
STAGE_ISE_INSECURE=true

# production environment (if available)
PROD_ISE_URL=...
PROD_ISE_USERNAME=...
PROD_ISE_PASSWORD=...
PROD_ISE_INSECURE=true